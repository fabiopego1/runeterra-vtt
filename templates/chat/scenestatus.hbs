{{!-- Runeterra Foundry — scene status card --}}
<div class="runeterra chat-card rt-scene-card">
  <h3>{{localize "RUNETERRA.SceneTracker"}}</h3>
  <div class="rt-scene-counts">
    <span class="rt-scene-green"><span class="rt-dot rt-dot-green"></span>{{gc}}/{{gmax}}</span>
    <span class="rt-scene-yellow"><span class="rt-dot rt-dot-yellow"></span>{{yc}}/{{ymax}}</span>
    <span class="rt-scene-red"><span class="rt-dot rt-dot-red"></span>{{rc}}/{{rmax}}</span>
  </div>
  {{#if message}}<p class="rt-scene-msg">{{message}}</p>{{/if}}
</div>
