{{!-- Runeterra Foundry — scene status card --}}
<div class="runeterra chat-card rt-scene-card">
  <h3>{{localize "RUNETERRA.SceneTracker"}}</h3>
  <div class="rt-scene-counts">
    <span class="rt-scene-green"><span class="rt-dot rt-dot-green"></span>{{gc}}/{{gt}}</span>
    <span class="rt-scene-yellow"><span class="rt-dot rt-dot-yellow"></span>{{yc}}/{{yt}}</span>
    <span class="rt-scene-red"><span class="rt-dot rt-dot-red"></span>{{rc}}/{{rt}}</span>
  </div>
</div>
