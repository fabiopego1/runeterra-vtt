{{!-- Runeterra Foundry — Scene Tracker (Gestor de Cena).
      Click a space to fill it; filling a zone advances the scene color for every champion. --}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header rt-header">
    <img class="rt-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="rt-header-fields">
      <h1><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'RUNETERRA.SceneTracker'}}" /></h1>
      <div class="rt-scene-status rt-scene-status-{{sceneColor}}{{#if sceneEnded}} rt-scene-ended{{/if}}">{{sceneLabel}}</div>
      <div class="rt-rollbar">
        <button type="button" class="scene-advance"{{#if sceneEnded}} disabled{{/if}}>{{localize "RUNETERRA.SceneAdvance"}}</button>
        <button type="button" class="scene-rewind"{{#if sceneAtStart}} disabled{{/if}}>{{localize "RUNETERRA.SceneRewind"}}</button>
        <button type="button" class="scene-reset">{{localize "RUNETERRA.SceneReset"}}</button>
        <select class="scene-preset">
          <option value="">{{localize "RUNETERRA.ScenePreset"}}</option>
          <option value="standard">{{localize "RUNETERRA.PresetStandard"}}</option>
          <option value="prolonged">{{localize "RUNETERRA.PresetProlonged"}}</option>
          <option value="epic">{{localize "RUNETERRA.PresetEpic"}}</option>
        </select>
      </div>
    </div>
  </header>
  <section class="sheet-body">
    {{#each zones}}
    <div class="rt-scene-zone rt-scene-zone-{{zone}}">
      <h4>{{label}}</h4>
      <div class="rt-scene-spaces">
        {{#each spaces}}
        {{#if filled}}
        <button type="button" class="scene-click filled" data-zone="{{../zone}}" data-i="{{i}}" title="{{localize 'RUNETERRA.SceneSpaceClick'}}"><i class="fas fa-star"></i></button>
        {{else}}
        <button type="button" class="scene-click" data-zone="{{../zone}}" data-i="{{i}}" title="{{localize 'RUNETERRA.SceneSpaceClick'}}"><i class="far fa-star"></i></button>
        {{/if}}
        {{/each}}
        <span class="rt-scene-count">{{current}}/{{setting}}</span>
        <label class="rt-scene-steps">{{localize "RUNETERRA.SceneSteps"}}</label>
        <input type="number" class="scene-setting" data-zone="{{zone}}" value="{{setting}}" min="1" max="8" />
      </div>
    </div>
    {{/each}}
    <div class="rt-scene-challenges">
      <h4>{{localize "RUNETERRA.ChTitle"}}</h4>
      {{#each challenges}}
      <div class="rt-ch {{#if resolved}}rt-ch-ok{{/if}}{{#if fired}}rt-ch-bad{{/if}}" data-id="{{id}}">
        <div class="rt-ch-head">
          <b>{{name}}</b>
          {{#if resolved}}<span class="rt-ch-tag rt-ch-tag-ok">{{localize "RUNETERRA.ChResolved"}}</span>{{/if}}
          {{#if fired}}<span class="rt-ch-tag rt-ch-tag-bad">{{localize "RUNETERRA.ChFired"}}</span>{{/if}}
          <button type="button" class="ch-del" title="{{localize 'RUNETERRA.ChDelete'}}"><i class="fas fa-times"></i></button>
        </div>
        <div class="rt-ch-line"><span>{{localize "RUNETERRA.ChSuccesses"}}</span>{{#each doneBoxes}}<button type="button" class="rt-ch-box rt-ch-s ch-done {{#if on}}on{{/if}}" data-i="{{i}}"></button>{{/each}}</div>
        {{#if timer}}<div class="rt-ch-line"><span>{{localize "RUNETERRA.ChTimer"}}</span>{{#each tickBoxes}}<button type="button" class="rt-ch-box rt-ch-t ch-tick {{#if on}}on{{/if}}" data-i="{{i}}"></button>{{/each}}</div>{{/if}}
      </div>
      {{else}}
      <p class="rt-hint"><em>{{localize "RUNETERRA.ChEmpty"}}</em></p>
      {{/each}}
      <div class="rt-ch-add">
        <input class="ch-new-name" type="text" maxlength="50" placeholder="{{localize 'RUNETERRA.ChPlaceholder'}}">
        <label>{{localize "RUNETERRA.ChSuccesses"}} <input class="ch-new-need" type="number" min="1" max="5" value="1"></label>
        <label>{{localize "RUNETERRA.ChTimer"}} <input class="ch-new-timer" type="number" min="0" max="8" value="0"></label>
        <button type="button" class="ch-add">{{localize "RUNETERRA.ChAdd"}}</button>
      </div>
      <p class="rt-hint"><em>{{localize "RUNETERRA.ChHint"}}</em></p>
    </div>
    {{#if isGM}}
    <div class="rt-scene-twist">
      <h4>{{localize "RUNETERRA.TwistTitle"}}</h4>
      <div class="rt-rollbar">
        <select class="twist-region">
          {{#select twistRegion}}<option value="any">{{localize "RUNETERRA.TwistAnywhere"}}</option>{{#each twistRegions}}<option value="{{id}}">{{name}}</option>{{/each}}{{/select}}
        </select>
        <button type="button" class="twist-roll" data-kind="minor">{{localize "RUNETERRA.TwistMinor"}}</button>
        <button type="button" class="twist-roll" data-kind="major">{{localize "RUNETERRA.TwistMajor"}}</button>
      </div>
      <p class="rt-hint"><em>{{localize "RUNETERRA.TwistHint"}}</em></p>
    </div>
    {{/if}}
    {{#if sceneEnded}}<p class="rt-scene-alert">{{localize "RUNETERRA.SceneEnd"}}</p>{{/if}}
    <p class="rt-hint"><em>{{localize "RUNETERRA.SceneHint"}}</em></p>
    <p class="rt-hint"><em>{{localize "RUNETERRA.SceneTurnHint"}}</em></p>
  </section>
</form>
