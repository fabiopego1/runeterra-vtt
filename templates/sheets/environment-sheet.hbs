{{!-- Runeterra Foundry — Environment sheet: 3 dice, description, and twist cards. --}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header rt-header">
    <img class="rt-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="rt-header-fields">
      <h1><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ACTOR.TypeEnvironment'}}" /></h1>
      <div class="rt-rollbar">
        <button type="button" class="make-roll"><i class="fas fa-dice-d20"></i> {{localize "RUNETERRA.RollCombined"}}</button>
        <button type="button" class="item-create" data-type="twist">+ {{localize "ITEM.TypeTwist"}}</button>
      </div>
    </div>
  </header>
  <section class="sheet-body">
    <div class="rt-roll-config">
      <label>{{localize "RUNETERRA.DicePower"}}</label>
      <select class="die-select" data-field="firstDie">
        {{#select system.firstDie}}{{#each dieTypes}}<option value="{{this}}">{{this}}</option>{{/each}}{{/select}}
      </select>
      <input type="text" name="system.firstDieName" value="{{system.firstDieName}}" />
      <label>{{localize "RUNETERRA.DiceQuality"}}</label>
      <select class="die-select" data-field="secondDie">
        {{#select system.secondDie}}{{#each dieTypes}}<option value="{{this}}">{{this}}</option>{{/each}}{{/select}}
      </select>
      <input type="text" name="system.secondDieName" value="{{system.secondDieName}}" />
      <label>{{localize "RUNETERRA.DiceStatus"}}</label>
      <select class="die-select" data-field="thirdDie">
        {{#select system.thirdDie}}{{#each dieTypes}}<option value="{{this}}">{{this}}</option>{{/each}}{{/select}}
      </select>
      <input type="text" name="system.thirdDieName" value="{{system.thirdDieName}}" />
    </div>

    <h3>{{localize "ITEM.TypeTwistPl"}}</h3>
    <table class="rt-abilities">
      <tbody>
        {{#each twists}}
        <tr data-item-id="{{id}}">
          <td class="rt-ability-name">{{name}}</td>
          <td class="rt-ability-text">{{{text}}}</td>
          <td class="rt-ability-actions">
            <button type="button" class="roll-item" title="{{localize 'RUNETERRA.UseAbility'}}"><i class="fas fa-dice-d20"></i></button>
            <button type="button" class="item-edit" title="{{localize 'RUNETERRA.Edit'}}"><i class="fas fa-pen"></i></button>
            <button type="button" class="item-delete" title="{{localize 'RUNETERRA.Delete'}}"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <h3>{{localize "RUNETERRA.Notes"}}</h3>
    <textarea name="system.description" rows="6">{{system.description}}</textarea>
  </section>
</form>
