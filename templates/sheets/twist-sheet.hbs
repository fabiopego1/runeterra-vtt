<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header"><h2><input name="name" type="text" value="{{item.name}}" /></h2></header>
  <section class="sheet-body">
    <div class="rt-grid">
      <label>Tipo</label>
      <select name="system.type">
        {{#select item.system.type}}{{#each config.twistType}}
        <option value="{{@key}}">{{localize this.label}}</option>
        {{/each}}{{/select}}
      </select>
    </div>
    <textarea name="system.description" rows="6">{{item.system.description}}</textarea>
  </section>
</form>
