<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header"><h2><input name="name" type="text" value="{{item.name}}" /></h2></header>
  <section class="sheet-body">
    <textarea name="system.rp" rows="3">{{item.system.rp}}</textarea>
    <textarea name="system.minor" rows="2">{{item.system.minor}}</textarea>
    <textarea name="system.major" rows="2">{{item.system.major}}</textarea>
    <textarea name="system.abilityText" rows="3">{{item.system.abilityText}}</textarea>
  </section>
</form>
